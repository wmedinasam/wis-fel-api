{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Issuer": "wis-fel-api",
    "PlatformAudience": "wis-fel-platform",
    "AgentAudience": "wis-fel-agent",
    "PlatformTokenMinutes": 15,
    "AgentTokenMinutes": 15,
    "PlatformRefreshTokenDays": 7,
    "AgentRefreshTokenDays": 30
  },
  "ClientJwt": {
    "Authority": "",
    "Audience": "",
    "RequireHttpsMetadata": true
  },
  "AgentHeartbeat": {
    "CommandLeaseSeconds": 30,
    "MaxCommandsPerHeartbeat": 20
  },
  "RateLimiting": {
    "PlatformLogin": { "PermitLimit": 10, "WindowSeconds": 60 },
    "PlatformRefresh": { "PermitLimit": 20, "WindowSeconds": 60 },
    "AgentHandshake": { "PermitLimit": 10, "WindowSeconds": 60 },
    "AgentRefresh": { "PermitLimit": 20, "WindowSeconds": 60 },
    "ClientMe": { "PermitLimit": 60, "WindowSeconds": 60 },
    "AgentHeartbeat": { "PermitLimit": 120, "WindowSeconds": 60 },
    "AgentDocumentStatus": { "PermitLimit": 60, "WindowSeconds": 60 },
    "PlatformAgentManagement": { "PermitLimit": 30, "WindowSeconds": 60 },
    "PlatformDocuments": { "PermitLimit": 60, "WindowSeconds": 60 },
    "TenantDocuments": { "PermitLimit": 60, "WindowSeconds": 60 }
  },
  "AllowedHosts": "*"
}
